rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }

    /* Admins: pega aquí el UID (no el DTK-xxxxx) de cada cuenta admin.
       Firebase Console > Authentication > Users > "UID de usuario" */
    function isAdmin() {
      return signed() && request.auth.uid in ["GU3mTrqd8PheN2Mn2Eb797hjasq2"];
    }

    function onlyMine(a, b) {
      return a.toSet().difference(b.toSet()).hasOnly([request.auth.uid])
          && b.toSet().difference(a.toSet()).hasOnly([request.auth.uid]);
    }
    function pairKey(a, b) { return a < b ? a + '_' + b : b + '_' + a; }
    function blockedBetween(a, b) {
      return exists(/databases/$(database)/documents/blocks/$(a + '_' + b))
          || exists(/databases/$(database)/documents/blocks/$(b + '_' + a));
    }
    function isMember(rid) {
      return signed() && (
        exists(/databases/$(database)/documents/invites/$(rid + '_' + request.auth.uid))
        || get(/databases/$(database)/documents/rooms/$(rid)).data.host == request.auth.uid);
    }

    match /users/{uid} {
      allow read: if true;
      allow write: if signed() && request.auth.uid == uid;
    }

    /* Solicitudes del formulario "Únete": cualquiera con sesión puede enviar,
       pero solo los admins pueden leer, marcar o borrar */
    match /applications/{id} {
      allow create: if signed()
        && request.resource.data.keys().hasOnly(['uid','nombre','correo','area','enlace','mensaje','cvPath','cvName','seen','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nombre is string && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() <= 80
        && request.resource.data.correo is string && request.resource.data.correo.size() > 0 && request.resource.data.correo.size() <= 120
        && request.resource.data.area is string && request.resource.data.area.size() > 0 && request.resource.data.area.size() <= 60
        && request.resource.data.enlace is string && request.resource.data.enlace.size() <= 300
        && request.resource.data.mensaje is string && request.resource.data.mensaje.size() > 0 && request.resource.data.mensaje.size() <= 2000
        && request.resource.data.cvPath is string && request.resource.data.cvPath.size() <= 300
        && request.resource.data.cvName is string && request.resource.data.cvName.size() <= 120
        && request.resource.data.seen == false
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    match /limits/{uid} {
      allow read: if signed() && request.auth.uid == uid;
      allow create: if signed() && request.auth.uid == uid && request.resource.data.last == request.time;
      allow update: if signed() && request.auth.uid == uid && request.resource.data.last == request.time
                    && request.time > resource.data.last + duration.value(60, 's');
    }

    match /posts/{id} {
      allow read: if true;
      allow create: if signed()
        && request.resource.data.keys().hasOnly(['uid','name','topic','text','stars','createdAt','likedBy','dislikedBy'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.topic is string && request.resource.data.topic.size() > 0 && request.resource.data.topic.size() <= 40
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 600
        && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.createdAt == request.time
        && request.resource.data.likedBy.size() == 0 && request.resource.data.dislikedBy.size() == 0
        && getAfter(/databases/$(database)/documents/limits/$(request.auth.uid)).data.last == request.time;
      allow update: if signed()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy','dislikedBy'])
        && onlyMine(request.resource.data.likedBy, resource.data.likedBy)
        && onlyMine(request.resource.data.dislikedBy, resource.data.dislikedBy);
      allow delete: if signed() && resource.data.uid == request.auth.uid;
    }

    match /replies/{id} {
      allow read: if true;
      allow create: if signed()
        && request.resource.data.keys().hasOnly(['uid','name','postId','text','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 400
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId));
      allow delete: if signed() && resource.data.uid == request.auth.uid;
    }

    match /friendships/{id} {
      allow read: if signed() && (resource == null || request.auth.uid in resource.data.users);
      allow create: if signed()
        && request.resource.data.from == request.auth.uid
        && request.auth.uid in request.resource.data.users
        && request.resource.data.users.size() == 2
        && request.resource.data.status == 'pending';
      allow update: if signed()
        && request.auth.uid in resource.data.users
        && request.resource.data.users == resource.data.users;
      allow delete: if signed() && request.auth.uid in resource.data.users;
    }

    /* Bloqueos: el documento es "quienBloquea_aQuienBloquea" */
    match /blocks/{bid} {
      allow read: if signed() && request.auth.uid in bid.split('_');
      allow create: if signed()
        && request.resource.data.keys().hasOnly(['by','target','createdAt'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.target != request.auth.uid
        && bid == request.auth.uid + '_' + request.resource.data.target
        && request.resource.data.createdAt == request.time;
      allow delete: if signed() && resource.data.by == request.auth.uid;
    }

    /* Mensajes: texto, foto (base64), GIF o video (archivo en Storage) */
    match /chats/{chatId}/messages/{msgId} {
      allow read: if signed() && request.auth.uid in chatId.split('_');
      allow create: if signed()
        && request.auth.uid in chatId.split('_')
        && get(/databases/$(database)/documents/friendships/$(chatId)).data.status == 'accepted'
        && !blockedBetween(chatId.split('_')[0], chatId.split('_')[1])
        && request.resource.data.keys().hasOnly(['uid','text','img','mkind','murl','mpath','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.text is string && request.resource.data.text.size() <= 1000
        && request.resource.data.img is string && request.resource.data.img.size() <= 500000
        && request.resource.data.get('mkind', '') in ['', 'video', 'gif']
        && request.resource.data.get('murl', '') is string
        && request.resource.data.get('murl', '').size() <= 900
        && (request.resource.data.get('murl', '') == '' || request.resource.data.get('murl', '').matches('https://firebasestorage.googleapis.com/.*'))
        && request.resource.data.get('mpath', '').size() <= 300
        && (request.resource.data.text.size() > 0 || request.resource.data.img.size() > 0 || request.resource.data.get('murl', '').size() > 0);
      allow delete: if signed() && request.auth.uid in chatId.split('_') && resource.data.uid == request.auth.uid;
    }

    /* Llamadas en grupo (WebRTC en malla; esto solo sirve de señalización) */
    match /rooms/{rid} {
      allow read: if signed() && (resource == null || isMember(rid));
      allow create: if signed()
        && request.resource.data.keys().hasOnly(['host','createdAt'])
        && request.resource.data.host == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow delete: if isMember(rid);

      match /peers/{pid} {
        allow read: if isMember(rid);
        allow create, update: if isMember(rid) && pid == request.auth.uid
          && request.resource.data.keys().hasOnly(['joinedAt','ts']);
        allow delete: if signed() && pid == request.auth.uid;
      }

      match /signals/{sgid} {
        allow read: if isMember(rid)
          && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
        allow create: if isMember(rid)
          && request.resource.data.keys().hasOnly(['from','to','type','sid','data','createdAt'])
          && request.resource.data.from == request.auth.uid
          && request.resource.data.type in ['offer','answer','cand']
          && request.resource.data.data is string && request.resource.data.data.size() < 30000
          && request.resource.data.createdAt == request.time;
        allow delete: if signed()
          && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      }
    }

    match /invites/{iid} {
      allow read: if signed() && (resource == null
        || resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create: if signed()
        && request.resource.data.keys().hasOnly(['roomId','from','to','createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to != request.auth.uid
        && iid == request.resource.data.roomId + '_' + request.resource.data.to
        && request.resource.data.createdAt == request.time
        && isMember(request.resource.data.roomId)
        && get(/databases/$(database)/documents/friendships/$(pairKey(request.auth.uid, request.resource.data.to))).data.status == 'accepted'
        && !blockedBetween(request.auth.uid, request.resource.data.to);
      allow delete: if signed()
        && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
    }
  }
}
