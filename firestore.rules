rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function onlyMine(a, b) {
      return a.toSet().difference(b.toSet()).hasOnly([request.auth.uid])
          && b.toSet().difference(a.toSet()).hasOnly([request.auth.uid]);
    }

    // Perfil: nombre y foto son públicos (salen en los comentarios); solo el dueño los edita
    match /users/{uid} {
      allow read: if true;
      allow write: if signed() && request.auth.uid == uid;
    }

    // Controla 1 comentario por minuto por usuario
    match /limits/{uid} {
      allow read: if signed() && request.auth.uid == uid;
      allow create: if signed() && request.auth.uid == uid && request.resource.data.last == request.time;
      allow update: if signed() && request.auth.uid == uid && request.resource.data.last == request.time
                    && request.time > resource.data.last + duration.value(60, 's');
    }

    match /posts/{id} {
      allow read: if true;
      allow create: if signed()
        && request.resource.data.keys().hasOnly(['uid','name','topic','text','stars','createdAt','likedBy','dislikedBy'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.topic is string && request.resource.data.topic.size() > 0 && request.resource.data.topic.size() <= 40
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 600
        && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.createdAt == request.time
        && request.resource.data.likedBy.size() == 0 && request.resource.data.dislikedBy.size() == 0
        && getAfter(/databases/$(database)/documents/limits/$(request.auth.uid)).data.last == request.time;
      allow update: if signed()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy','dislikedBy'])
        && onlyMine(request.resource.data.likedBy, resource.data.likedBy)
        && onlyMine(request.resource.data.dislikedBy, resource.data.dislikedBy);
      allow delete: if signed() && resource.data.uid == request.auth.uid;
    }

    match /replies/{id} {
      allow read: if true;
      allow create: if signed()
        && request.resource.data.keys().hasOnly(['uid','name','postId','text','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 400
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId));
      allow delete: if signed() && resource.data.uid == request.auth.uid;
    }
  }
}
