rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function onlyMine(a, b) {
      return a.toSet().difference(b.toSet()).hasOnly([request.auth.uid])
          && b.toSet().difference(a.toSet()).hasOnly([request.auth.uid]);
    }

    match /users/{uid} {
      allow read: if true;
      allow write: if signed() && request.auth.uid == uid;
    }

    match /limits/{uid} {
      allow read: if signed() && request.auth.uid == uid;
      allow create: if signed() && request.auth.uid == uid && request.resource.data.last == request.time;
      allow update: if signed() && request.auth.uid == uid && request.resource.data.last == request.time
                    && request.time > resource.data.last + duration.value(60, 's');
    }

    match /posts/{id} {
      allow read: if true;
      allow create: if signed()
        && request.resource.data.keys().hasOnly(['uid','name','topic','text','stars','createdAt','likedBy','dislikedBy'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.topic is string && request.resource.data.topic.size() > 0 && request.resource.data.topic.size() <= 40
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 600
        && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.createdAt == request.time
        && request.resource.data.likedBy.size() == 0 && request.resource.data.dislikedBy.size() == 0
        && getAfter(/databases/$(database)/documents/limits/$(request.auth.uid)).data.last == request.time;
      allow update: if signed()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy','dislikedBy'])
        && onlyMine(request.resource.data.likedBy, resource.data.likedBy)
        && onlyMine(request.resource.data.dislikedBy, resource.data.dislikedBy);
      allow delete: if signed() && resource.data.uid == request.auth.uid;
    }

    match /replies/{id} {
      allow read: if true;
      allow create: if signed()
        && request.resource.data.keys().hasOnly(['uid','name','postId','text','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 400
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId));
      allow delete: if signed() && resource.data.uid == request.auth.uid;
    }

    match /friendships/{id} {
      allow read: if signed() && (resource == null || request.auth.uid in resource.data.users);
      allow create: if signed()
        && request.resource.data.from == request.auth.uid
        && request.auth.uid in request.resource.data.users
        && request.resource.data.users.size() == 2
        && request.resource.data.status == 'pending';
      allow update: if signed()
        && request.auth.uid in resource.data.users
        && request.resource.data.users == resource.data.users;
      allow delete: if signed() && request.auth.uid in resource.data.users;
    }

    match /chats/{chatId}/messages/{msgId} {
      allow read: if signed() && request.auth.uid in chatId.split('_');
      allow create: if signed()
        && request.auth.uid in chatId.split('_')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && (request.resource.data.text.size() > 0 || request.resource.data.img.size() > 0)
        && request.resource.data.text.size() <= 1000
        && request.resource.data.img.size() <= 500000;
    }

    /* Llamadas de voz: señalización WebRTC */
    match /calls/{callId} {
      allow read: if signed() && (resource == null
                    || resource.data.to == request.auth.uid
                    || resource.data.from == request.auth.uid);
      allow create: if signed()
        && request.auth.uid in callId.split('_')
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to in callId.split('_')
        && request.resource.data.to != request.auth.uid
        && request.resource.data.keys().hasOnly(['from','to','cid','status','offer','createdAt'])
        && request.resource.data.status == 'ringing'
        && get(/databases/$(database)/documents/friendships/$(callId)).data.status == 'accepted';
      allow update: if signed()
        && resource.data.to == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer','status']);
      allow delete: if signed()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);

      match /cand/{id} {
        allow read: if signed() && request.auth.uid in callId.split('_');
        allow create: if signed()
          && request.auth.uid in callId.split('_')
          && request.resource.data.uid == request.auth.uid;
        allow delete: if signed() && resource.data.uid == request.auth.uid;
      }
    }
  }
}